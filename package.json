{
  "name": "heatmap",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Browser-based heatmap generator for activity exports",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/app.js src/worker.js src/style.css --bundle --format=esm --minify --outdir=public",
    "start": "node server.js",
    "dev": "npm run build && npm start",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fit-file-parser": "^6.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2"
  }
}
